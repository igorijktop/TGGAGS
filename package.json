{
  "name": "tggags-ide",
  "productName": "TGGAGS IDE",
  "version": "1.1.0",
  "description": "A next-generation AI IDE: editor, coding agents, terminal, Git, debugger, LSP, MCP, image studio and more.",
  "author": "TGGAGS",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "package:win": "node scripts/package-win.mjs",
    "installer:win": "node scripts/package-win.mjs --installer",
    "test:packaged": "node tests/e2e/packaged.mjs"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@types/node": "^26.6.4",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.5.1",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "resedit": "^3.1.0",
    "typescript": "5.9",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "fflate": "^0.8.3",
    "ignore": "^7.0.12",
    "lucide-react": "^1.52.0",
    "monaco-editor": "^0.57.0",
    "picomatch": "^4.0.7",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  }
}
